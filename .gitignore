# ---- Env ----
.env
!.env.example

# ---- Python 3.11+ ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- Node / Vite ----
node_modules/
dist/
dist-ssr/
.vite/

# ---- Data artifacts (keep dirs via .gitkeep, ignore contents) ----
data/raw/*
data/processed/*
data/synthetic/*
data/public/cse_cic_ids2018/raw/*
data/public/cicids2017/raw/*
data/public/cicids2017/*.zip
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep
models/ueba/*
!models/ueba/.gitkeep
*.csv
*.parquet
*.pkl
*.joblib
*.h5
*.onnx

# ---- Evaluation output (regenerable, never committed) ----
evaluation/

# ---- ML / Vector / Graph local state ----
chroma_db/
embeddings/
mlruns/
neo4j/data/
neo4j/logs/

# ---- Logs ----
*.log
logs/

# ---- Local databases ----
*.db
*.sqlite
*.sqlite3

# ---- OS / IDE ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Keep empty scaffold dirs tracked ----
!**/.gitkeep
