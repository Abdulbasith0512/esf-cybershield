# Copy to .env — placeholders only, no real secrets.
APP_ENV=development

# Backend / Frontend
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL
POSTGRES_DB=esf
POSTGRES_USER=esf
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://esf:changeme@localhost:5432/esf

# Neo4j (planned)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ChromaDB (planned)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Ollama (planned)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# App secret (replace locally, never commit real value)
SECRET_KEY=change-me-in-local-env-only
